#!/usr/bin/env bash
#
# zrush — pick a git worktree *or one of its Claude Code sessions* with fzf,
#         then open it in your editor.
#
# The association worktree <-> session lives in the worktree's own gitdir:
#
#     <git rev-parse --absolute-git-dir>/zrush-session      # session_id=<uuid>
#
# i.e. `repo/.git/worktrees/<name>` for a linked worktree, `repo/.git` for the
# main one. Per-worktree by construction, so several Zed windows can each hold
# their own session. No global state, no secrets. `zrush_session`, the shell Zed
# starts in its terminal panel, reads that file and resumes the session.
#
# The picker LOOPS: after Zed opens, or after you quit claude, you land back on
# the (refreshed) list. Esc / ctrl-c / ctrl-q leaves zrush.
#
#   enter    on a WORKTREE  always a new session: drop the association, open
#                           the editor, zrush_session starts a fresh Claude
#            on a SESSION   write that session id, then open the editor
#                           -> zrush_session resumes it
#            on [...more]   load more of that worktree's older sessions
#   ctrl-o   start a new `claude` session for the worktree, in a new terminal
#   ctrl-w   create a worktree; on a session row, bind that session to it
#   ctrl-d   on a SESSION delete that conversation; on a WORKTREE remove it,
#            and optionally delete the sessions that belong to it
#   left/right  fold / unfold a worktree's rows
#   ctrl-l   reload the list
#
# The last line of the list creates a worktree: it asks for a name, runs
# `git worktree add` under <main worktree>/.claude/worktrees/, and opens Zed.
#
# Deps: git, fzf, zed, claude. Optional: jq (session rows, titles, badges).
# Config: ~/.config/zrush/config   (shell syntax, sourced)
#           ZRUSH_DEFAULT_REPO="/path/to/main/repo"   # used when cwd is not a git repo
#           ZRUSH_EDITOR=zed|cursor|code              # editor `enter` opens
#           ZRUSH_EDITOR_CMD=(code --reuse-window)     # or the whole command line
#           ZRUSH_TERMINAL=(open -a Ghostty)        # how ctrl-o opens a terminal
#           ZRUSH_TITLES=0                            # skip the transcript probe
#           ZRUSH_STATUS=0                            # skip the git status column
#           ZRUSH_RESUMABLE_MAX=5                     # dead sessions listed per worktree
#           ZRUSH_RESUMABLE_SCAN=40                   # newest transcripts examined
#           ZRUSH_FZF_HEIGHT="80%"                    # inline instead of full screen
#           ZRUSH_TITLE_WIDTH=48                      # truncate session titles here
# Cache:  ~/.cache/zrush/sessions/  (derived data only, safe to delete)
# No secrets are ever stored.

set -uo pipefail
IFS=$'\n\t'

PROG=${0##*/}
# Absolute path to this script: fzf's reload binding re-runs it.
SELF=$0
case "$SELF" in */*) ;; *) SELF=$(command -v -- "$SELF" 2>/dev/null || printf %s "$SELF") ;; esac
case "$SELF" in */*) SELF=$(cd -- "${SELF%/*}" 2>/dev/null && pwd)/${SELF##*/} ;; esac
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zrush"
CONFIG_FILE="$CONFIG_DIR/config"
CLAUDE_PROJECTS="$HOME/.claude/projects"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zrush/sessions"
STATE_BASENAME="zrush-session"
TAIL_LINES=400          # how far back we look in a transcript

# ---------------------------------------------------------------- helpers ---
die()  { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
warn() { printf '%s: %s\n' "$PROG" "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

is_uuid() {
  case "$1" in
    [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]-[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]-[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]-[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]-[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) return 0 ;;
  esac
  return 1
}

usage() {
  cat <<EOF
$PROG — git worktree / Claude session router for your editor

usage: $PROG [options]

  -C, --repo <path>   use this repo instead of auto-detecting from \$PWD
  -p, --print         print the selected path and exit (no action)
  -l, --list          print the table to stdout and exit (no fzf)
  -n, --no-sessions   skip Claude session lookup (faster)
  -S, --no-status     skip the git status column (faster on huge repos)
  -1, --once          act on one selection then exit (no loop)
  -h, --help          this help

keys inside fzf:
  enter    worktree: always a new session -- open the editor, zrush_session
                     starts a fresh Claude there
           session:  bind it to the worktree, open the editor (zrush_session
                     resumes it)
           [...more]: load more of that worktree's older sessions
  ctrl-o   start a NEW claude session for this worktree, in its own terminal
           (association and editor untouched)
  ctrl-w   create a worktree; on a session row, bind that session to it
  ctrl-d   on a session: delete that conversation
           on a worktree: remove it, and optionally delete its sessions
  ctrl-l   reload the list
  left     fold this worktree's rows   (right unfolds)
  last row create a new worktree (asks for a name)
  esc / ctrl-c / ctrl-q            quit zrush
EOF
}

# --------------------------------------------------------------- cli args ---
REPO_ARG=""
PRINT_ONLY=0
LIST_ONLY=0
MENU_ONLY=0
RENDER_ONLY=0
STATE_DIR=""
SESSIONS_OF=""
DO_ACTION=""
DO_PATH=""
DO_TYPE=""
DO_ID=""
DO_NAME=""
ASK=""
ANSWER=""
SHOW=0
Q_TEXT=""
Q_CUR=""
FOLD_PATH=""
UNFOLD_PATH=""
MORE_PATH=""
WANT_SESSIONS=1
LOOP=1
while [ $# -gt 0 ]; do
  case "$1" in
    -C|--repo)        REPO_ARG="${2:-}"; [ -n "$REPO_ARG" ] || die "--repo needs a path"; shift 2 ;;
    -p|--print)       PRINT_ONLY=1; LOOP=0; shift ;;
    -l|--list)        LIST_ONLY=1; shift ;;
    # Internal, for fzf's reload bindings: folding must not tear the picker
    # down and build it again, so a child process mutates the shared state
    # directory and prints the new menu on stdout.
    --menu)           MENU_ONLY=1; shift ;;
    --render)         RENDER_ONLY=1; shift ;;
    --sessions)       SESSIONS_OF="${2:-}"; [ -n "$SESSIONS_OF" ] || die "--sessions needs a path"; shift 2 ;;
    # Internal, run by fzf's execute(): the prompts happen on the real
    # terminal while the picker waits, instead of quitting and coming back.
    --do)             DO_ACTION="${2:-}"; shift 2 ;;
    --path)           DO_PATH="${2:-}"; shift 2 ;;
    --type)           DO_TYPE="${2:-}"; shift 2 ;;
    --id)             DO_ID="${2:-}"; shift 2 ;;
    --name)           DO_NAME="${2:-}"; shift 2 ;;
    --ask)            ASK="${2:-}"; shift 2 ;;
    --show)           SHOW=1; shift ;;
    --answer)         ANSWER="${2:-}"; shift 2 ;;
    --query)          Q_TEXT="${2:-}"; shift 2 ;;
    --current)        Q_CUR="${2:-}"; shift 2 ;;
    --state)          STATE_DIR="${2:-}"; [ -n "$STATE_DIR" ] || die "--state needs a path"; shift 2 ;;
    --fold)           FOLD_PATH="${2:-}"; shift 2 ;;
    --unfold)         UNFOLD_PATH="${2:-}"; shift 2 ;;
    --more)           MORE_PATH="${2:-}"; shift 2 ;;
    -n|--no-sessions) WANT_SESSIONS=0; shift ;;
    -S|--no-status)   ZRUSH_STATUS=0; shift ;;
    -1|--once)        LOOP=0; shift ;;
    -h|--help)        usage; exit 0 ;;
    *)                die "unknown option: $1 (try --help)" ;;
  esac
done

# --sessions and --do carry their own target, so the repo comes from it.
[ -n "$SESSIONS_OF" ] && [ -z "$REPO_ARG" ] && REPO_ARG="$SESSIONS_OF"
[ -n "$DO_ACTION" ] && [ -z "$REPO_ARG" ] && [ -d "$DO_PATH" ] && REPO_ARG="$DO_PATH"
{ [ -n "$ASK" ] || [ -n "$ANSWER" ] || [ "$SHOW" -eq 1 ]; } && [ -z "$REPO_ARG" ] && [ -d "$DO_PATH" ] && REPO_ARG="$DO_PATH"

for c in git fzf; do have "$c" || die "missing dependency: $c"; done

# ---------------------------------------------------------------- config ----
mkdir -p "$CONFIG_DIR"
ZRUSH_DEFAULT_REPO="${ZRUSH_DEFAULT_REPO:-}"
# Which editor `enter` opens a worktree in. A known name gets the right
# "new window" flag; anything else is run as-is with the path appended.
#   zed | cursor | code   ->  <editor> -n <path>
# ZRUSH_EDITOR_CMD overrides the whole command line, e.g. (code --reuse-window).
ZRUSH_EDITOR="${ZRUSH_EDITOR:-zed}"
declare -a ZRUSH_EDITOR_CMD=()
# How ctrl-o opens a terminal for a new Claude session. Empty means `open`,
# which hands the script to whatever app owns .command files -- Terminal.app
# unless you point that at iTerm yourself. Anything else is run with the
# script appended: (open -a Ghostty), (wezterm start), ...
declare -a ZRUSH_TERMINAL=()
# Defaults, overridable from the environment, then from the config file.
ZRUSH_TITLES="${ZRUSH_TITLES:-1}"             # 0 disables the transcript probe
ZRUSH_STATUS="${ZRUSH_STATUS:-1}"             # 0 disables the per-worktree git status
ZRUSH_RESUMABLE_MAX="${ZRUSH_RESUMABLE_MAX:-5}"    # dead sessions listed per worktree (0 = none)
ZRUSH_RESUMABLE_SCAN="${ZRUSH_RESUMABLE_SCAN:-40}" # newest transcripts examined, repo-wide
ZRUSH_MORE_STEP="${ZRUSH_MORE_STEP:-20}"           # rows added by one "[...more]"
# Empty = full screen: fzf takes the whole terminal on its alternate screen
# and gives it back untouched on exit. Set e.g. "80%" to keep it inline.
ZRUSH_FZF_HEIGHT="${ZRUSH_FZF_HEIGHT:-}"
ZRUSH_TITLE_WIDTH="${ZRUSH_TITLE_WIDTH:-48}"
# shellcheck disable=SC1090
_zrush_status_cli="$ZRUSH_STATUS"
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"
# An explicit -S on the command line outranks the config file.
[ "$_zrush_status_cli" = "0" ] && ZRUSH_STATUS=0
# Tolerate ZRUSH_EDITOR_CMD="code -n" (a plain string) in the config file:
# assigning a string to an already-declared array just fills element 0.
if [ "${#ZRUSH_EDITOR_CMD[@]}" -eq 1 ]; then
  case "${ZRUSH_EDITOR_CMD[0]}" in
    *[[:space:]]*) IFS=$' \t\n' read -r -a ZRUSH_EDITOR_CMD <<<"${ZRUSH_EDITOR_CMD[0]}" ;;
  esac
fi
if [ "${#ZRUSH_TERMINAL[@]}" -eq 1 ]; then
  case "${ZRUSH_TERMINAL[0]}" in
    *[[:space:]]*) IFS=$' \t\n' read -r -a ZRUSH_TERMINAL <<<"${ZRUSH_TERMINAL[0]}" ;;
  esac
fi
[ "${#ZRUSH_TERMINAL[@]}" -gt 0 ] && [ -n "${ZRUSH_TERMINAL[0]}" ] || ZRUSH_TERMINAL=(open)

if [ "${#ZRUSH_EDITOR_CMD[@]}" -eq 0 ] || [ -z "${ZRUSH_EDITOR_CMD[0]}" ]; then
  case "$ZRUSH_EDITOR" in
    # -n on all three: a worktree nested inside another one is otherwise
    # swallowed by the parent project's window.
    zed|cursor|code) ZRUSH_EDITOR_CMD=("$ZRUSH_EDITOR" -n) ;;
    "")              ZRUSH_EDITOR_CMD=(zed -n) ;;
    *)               ZRUSH_EDITOR_CMD=("$ZRUSH_EDITOR") ;;
  esac
fi

# Hash used as the session-metadata cache key. No hasher -> no cache, and the
# probe simply runs every time.
if have md5; then       hash_stdin() { md5 -q; }
elif have md5sum; then  hash_stdin() { md5sum | cut -d' ' -f1; }
else                    hash_stdin() { return 1; }
fi

if [ "$ZRUSH_TITLES" != "0" ] && [ "$WANT_SESSIONS" -eq 1 ]; then
  mkdir -p "$CACHE_DIR" 2>/dev/null
  # Derived data only: drop whatever has not been touched in a month.
  find "$CACHE_DIR" -type f -mtime +30 -delete 2>/dev/null
fi

# ------------------------------------------------------- locate the repo ----
# Any worktree works: `git worktree list` always reports the whole set,
# with the main worktree as its first entry.
repo_dir=""
if [ -n "$REPO_ARG" ]; then
  [ -d "$REPO_ARG" ] || die "not a directory: $REPO_ARG"
  repo_dir="$REPO_ARG"
elif git rev-parse --git-dir >/dev/null 2>&1; then
  repo_dir="$PWD"
elif [ -n "$ZRUSH_DEFAULT_REPO" ] && [ -d "$ZRUSH_DEFAULT_REPO" ]; then
  repo_dir="$ZRUSH_DEFAULT_REPO"
else
  die "not inside a git repository. Use --repo <path>, or set ZRUSH_DEFAULT_REPO in $CONFIG_FILE"
fi
git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository: $repo_dir"

# Absolute path of the main worktree (first porcelain entry), for display only.
main_root=$(git -C "$repo_dir" worktree list --porcelain | awk '/^worktree /{sub(/^worktree /,""); print; exit}')
# New worktrees land beside the ones `claude --worktree` makes.
new_root="$main_root/.claude/worktrees"
# Stands in for a worktree in the rows: it can never be a real path.
ORPHANS="(orphaned)"

# A child spawned by a reload binding is handed the parent's state directory
# and must not delete it; only the process that created it cleans up.
if [ -n "$STATE_DIR" ]; then
  [ -d "$STATE_DIR" ] || die "no such state directory: $STATE_DIR"
  tmpdir="$STATE_DIR"
else
  tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/zrush.XXXXXX") || die "mktemp failed"
  trap 'rm -rf "$tmpdir"' EXIT
fi
sessions_file="$tmpdir/sessions"   # cwd \t id \t title \t status \t launch-cwd \t kind \t epoch
owned_file="$tmpdir/owned"         # worktree \t id \t title \t status \t kind
counts_file="$tmpdir/counts"       # worktree \t resumable-total \t resumable-shown
expand_file="$tmpdir/expanded"     # worktree \t how many resumables to show there
collapse_file="$tmpdir/collapsed"  # one worktree path per line: its rows are folded
status_file="$tmpdir/status"       # worktree \t git badge, one full refresh's worth
# Helper scripts fzf calls back into. Named here so a child spawned by a
# binding, which only gets --state, can point at them too. No parentheses in
# FOOTER: it is passed inside change-footer( ).
reload_sh="$tmpdir/reload"; RELOAD_SH="$reload_sh"
act_sh="$tmpdir/act";       ACT_SH="$act_sh"
do_sh="$tmpdir/do"
ans_sh="$tmpdir/ans";       ANS_SH="$ans_sh"
ask_sh="$tmpdir/ask";       ASK_SH="$ask_sh"
show_sh="$tmpdir/show"
FOOTER='enter open  ^o claude  ^w worktree  ^d delete  ^l reload  ←→ fold  esc quit'
[ -n "$STATE_DIR" ] || { : > "$expand_file"; : > "$collapse_file"; : > "$status_file"; }
wtlist="$tmpdir/wtlist"            # label \t path
menu="$tmpdir/menu"                # display \t path \t type \t id

# ---------------------------------------------- per-worktree session state --
state_file() {  # $1 = worktree path
  local gd
  gd=$(git -C "$1" rev-parse --absolute-git-dir 2>/dev/null) || return 1
  [ -n "$gd" ] && [ -d "$gd" ] || return 1
  printf '%s/%s' "$gd" "$STATE_BASENAME"
}

state_read() {  # $1 = worktree path -> prints the session id, if any
  local f
  f=$(state_file "$1") || return 1
  [ -f "$f" ] || return 1
  sed -n 's/^[[:space:]]*session_id[[:space:]]*=[[:space:]]*\([^[:space:]]*\).*/\1/p' \
      "$f" 2>/dev/null | head -1
}

state_write() {  # $1 = worktree path, $2 = session id
  local f tmp
  is_uuid "$2" || { warn "refusing to store a malformed session id"; return 1; }
  f=$(state_file "$1") || { warn "no gitdir for $1"; return 1; }
  tmp="$f.tmp.$$"
  if printf 'session_id=%s\n' "$2" > "$tmp" 2>/dev/null && mv -f "$tmp" "$f" 2>/dev/null; then
    return 0
  fi
  rm -f "$tmp" 2>/dev/null
  warn "could not write $f"
  return 1
}

state_clear() {  # $1 = worktree path
  local f
  f=$(state_file "$1") || { warn "no gitdir for $1"; return 1; }
  [ -f "$f" ] || return 0
  rm -f "$f" 2>/dev/null || { warn "could not remove $f"; return 1; }
}

# ------------------------------------- best-effort transcript probe --------
# `claude agents --json` reports the cwd a session was LAUNCHED in, not the one
# it has since moved to, and no title at all. Both live in the transcript:
#   {"type":"ai-title","aiTitle":…}   rewritten as the session goes on
#   every assistant/user line carries .cwd and .gitBranch
# So we read the tail of the transcript for them. Best-effort in every sense:
# any failure falls back to the session's name and its launch cwd, and nothing
# here is ever used to resume — `claude --resume <id>` stays the only way.
# Results are cached under $CACHE_DIR, keyed by the md5 of the tail we read.

slugify() { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }

# Folding a worktree hides its session rows. left folds, right unfolds.
is_collapsed()   { grep -qxF "$1" "$collapse_file" 2>/dev/null; }
collapse_set()   { is_collapsed "$1" || printf '%s\n' "$1" >> "$collapse_file"; }
collapse_unset() {
  grep -vxF "$1" "$collapse_file" > "$collapse_file.new" 2>/dev/null
  mv -f "$collapse_file.new" "$collapse_file" 2>/dev/null
}

# `stat` differs between BSD and GNU; settle on one once.
if stat -f '%m' . >/dev/null 2>&1; then
  mtime_of()  { stat -f '%m' "$1" 2>/dev/null; }
  mtime_list() { find "$@" -maxdepth 1 -type f -name '*.jsonl' -exec stat -f '%m %N' {} + 2>/dev/null; }
else
  mtime_of()  { stat -c '%Y' "$1" 2>/dev/null; }
  mtime_list() { find "$@" -maxdepth 1 -type f -name '*.jsonl' -exec stat -c '%Y %n' {} + 2>/dev/null; }
fi

# Compact age, for the session rows: 40m, 6h, 3d, 5mo.
NOW=$(date +%s)          # one `date` for the whole run, not one per row
age_of() {  # $1 = epoch seconds
  local d
  d=$(( NOW - ${1:-0} ))
  [ "$d" -lt 0 ] && d=0
  if   [ "$d" -lt 3600 ];    then printf '%dm'  $(( d / 60 ))
  elif [ "$d" -lt 86400 ];   then printf '%dh'  $(( d / 3600 ))
  elif [ "$d" -lt 2592000 ]; then printf '%dd'  $(( d / 86400 ))
  else                            printf '%dmo' $(( d / 2592000 ))
  fi
}

transcript_path() {  # $1 = launch cwd, $2 = session id
  printf '%s/%s/%s.jsonl' "$CLAUDE_PROJECTS" "$(slugify "$1")" "$2"
}

# Two-level cache under $CACHE_DIR/<id>, one line:
#     <size>-<mtime> \t <md5 of the tail> \t <title> \t <cwd>
# A matching size+mtime answers without reading the transcript at all; a
# matching md5 answers when the file was touched but its tail did not change.
session_meta() {  # $1 = id, $2 = launch cwd  ->  prints "<title>\t<cwd>"
  session_meta_file "$(transcript_path "$2" "$1")" "$1"
}

# Cache key for a transcript whose mtime the scan already read: the "m" keeps
# it distinct from the "<size>-<mtime>" the live path builds.

# $3, when given, is the file's mtime, already known from the directory scan.
# Passing it keeps this function fork-free on a cache hit, which matters: the
# scan calls it once per transcript and a repo can hold hundreds.
session_meta_file() {  # $1 = path, $2 = id, [$3 = mtime]  ->  "<title>\t<cwd>"
  [ "$ZRUSH_TITLES" != "0" ] || return 1
  local f cache line st key meta blob c_st c_md5 c_title c_cwd _t
  f="$1"; st="${3:-}"; set -- "$2"
  [ -n "$st" ] || [ -f "$f" ] || return 1
  cache="$CACHE_DIR/$1"
  [ -n "$st" ] || st=$(stat -f '%z-%m' "$f" 2>/dev/null || stat -c '%s-%Y' "$f" 2>/dev/null) || st=""

  c_st=""; c_md5=""; c_title=""; c_cwd=""
  if [ -f "$cache" ]; then
    line=""; IFS= read -r line < "$cache" 2>/dev/null || line=""
    IFS=$'\t' read -r c_st c_md5 c_title c_cwd <<<"$line"
    if [ -n "$st" ] && [ "$st" = "$c_st" ] && [ -n "$c_cwd" ]; then
      printf '%s\t%s' "$c_title" "$c_cwd"
      return 0
    fi
  fi

  # Via a file, not a shell variable: 400 transcript lines run to megabytes,
  # and pushing that through a command substitution costs more than the parse.
  blob="$tmpdir/blob"
  tail -n "$TAIL_LINES" "$f" > "$blob" 2>/dev/null || return 1
  [ -s "$blob" ] || return 1
  key=$(hash_stdin < "$blob" 2>/dev/null) || key=""

  if [ -n "$key" ] && [ "$key" = "$c_md5" ] && [ -n "$c_cwd" ]; then
    printf '%s\t%s\t%s\t%s\n' "$st" "$key" "$c_title" "$c_cwd" > "$cache" 2>/dev/null
    printf '%s\t%s' "$c_title" "$c_cwd"
    return 0
  fi

  # Also the timestamp of the last entry. A transcript's mtime is useless as
  # an age: Claude Code rewrites them in batches, so ten conversations from
  # different days end up sharing one mtime to the minute.
  meta=$(jq -Rr 'fromjson? // empty
                 | select(.aiTitle != null or .cwd != null or .timestamp != null)
                 | [(.aiTitle // ""), (.cwd // ""),
                    ((.timestamp // "") | if . == "" then "" else
                       (sub("\\.[0-9]+Z$"; "Z") | try fromdateiso8601 catch "") end | tostring)]
                 | @tsv' < "$blob" 2>/dev/null \
    | awk -F'\t' '{ if ($1 != "") t = $1; if ($2 != "") c = $2; if ($3 != "") s = $3 }
                  END { gsub(/\t/, " ", t); printf "%s\t%s\t%s", t, c, s }')

  # The title is written once, early, so a long conversation pushes it out of
  # the tail window -- 7 of 125 transcripts here. Fall back to grepping the
  # whole file and parsing only the last line that carries one: one pass over
  # the file, one tiny jq, and the result is cached like everything else.
  if [ -z "${meta%%$'\t'*}" ]; then
    _t=$(grep '"aiTitle"' "$f" 2>/dev/null | tail -1 \
         | jq -r '.aiTitle // empty' 2>/dev/null | tr '\t' ' ')
    [ -n "$_t" ] && meta="$_t"$'\t'"${meta#*$'\t'}"
  fi
  [ -n "${meta#	}" ] || return 1

  [ -n "$key" ] && printf '%s\t%s\t%s\n' "$st" "$key" "$meta" > "$cache" 2>/dev/null
  printf '%s' "$meta"
}

# --------------------------------------------------- live Claude sessions ---
# Official, scriptable source of truth: `claude agents --json`.
# Background sessions are dropped: they are reattached with `claude attach`,
# not `--resume`, so they are not something zrush can bind to an editor.
# Each row is enriched with the transcript probe above:
#   <effective cwd> \t <id> \t <label> \t <status> \t <launch cwd>
refresh_sessions() {
  : > "$sessions_file"
  [ "$WANT_SESSIONS" -eq 1 ] || return 0
  have claude && have jq || return 0
  local id cwd name status started meta title ecwd rest lastts
  while IFS=$'\t' read -r cwd id name status started; do  # cwd, id, name, status, startedAt
    [ -n "$id" ] || continue
    title=""; ecwd=""; lastts=""
    if meta=$(session_meta "$id" "$cwd"); then
      title=${meta%%$'\t'*}
      rest=${meta#*$'\t'}; ecwd=${rest%%$'\t'*}; lastts=${rest#*$'\t'}
      case "$lastts" in ''|*[!0-9]*) lastts="" ;; esac
    fi
    # A name you set with `claude -n` beats the title Claude generated for
    # itself. Auto-generated names look like "<dir>-<2 hex>" (wms-e8, 2346-06),
    # so anything else is yours and wins.
    case "$name" in
      "$(basename "$cwd")"-[0-9a-f][0-9a-f]) ;;          # auto, keep the title
      "") ;;
      *) title="$name" ;;                                 # yours, use it
    esac
    [ -n "$title" ] || title="$name"
    [ -n "$ecwd" ]  || ecwd="$cwd"
    if [ "${#title}" -gt "$ZRUSH_TITLE_WIDTH" ]; then
      title="${title:0:$((ZRUSH_TITLE_WIDTH - 1))}…"
    fi
    # The last message beats the process start time: a session idle since
     # yesterday should not read as "0m" because you just reopened it.
    [ -n "$lastts" ] && started="$lastts"
    [ "${started:-0}" -gt 0 ] 2>/dev/null && status="$status $(age_of "$started")"
    printf '%s\t%s\t%s\t%s\t%s\tlive\t%s\n' \
      "$ecwd" "$id" "$title" "$status" "$cwd" "${started:-0}" >> "$sessions_file"
  # `claude agents` lists one entry per PROCESS, and two processes can share a
  # session id (`claude -c` on a conversation that is already open). Group by
  # sessionId so a session is one row, not one row per process.
  done < <(claude agents --json --all 2>/dev/null \
           | jq -r '[ .[]?
                      | select((.kind // "") == "interactive")
                      | select((.sessionId // "") != "") ]
                    | group_by(.sessionId)[]
                    | max_by(.startedAt // 0)
                    | [.cwd // "", .sessionId, .name // (.sessionId[0:8]), .status // "",
                       ((.startedAt // 0) / 1000 | floor)]
                    | @tsv' 2>/dev/null)
}

# A session's cwd may be a subdirectory of the worktree, or a worktree the
# session moved into after launch. Attach each one to the worktree that is the
# longest prefix of its effective cwd, falling back to its launch cwd.
assign_sessions() {
  : > "$owned_file"
  [ -s "$sessions_file" ] && [ -s "$wtlist" ] || return 0
  awk -F'\t' -v OFS='\t' -v maxr="${ZRUSH_RESUMABLE_MAX:-0}" \
      -v ef="$expand_file" -v wl="$wtlist" -v cf="$counts_file" \
      -v nr="$new_root" -v orph="$ORPHANS" -v mr="$main_root" '
    function owner(cwd,   i, p, l, best, bl) {
      best = ""; bl = 0
      for (i = 1; i <= nwt; i++) {
        p = wp[i]; l = length(p)
        if (cwd == p || substr(cwd, 1, l + 1) == p "/") { if (l > bl) { bl = l; best = p } }
      }
      return best
    }
    function islive(p,   i) {
      for (i = 1; i <= nwt; i++) if (wp[i] == p) return 1
      return 0
    }
    # The worktree a path was *meant* for, when that worktree is gone. A
    # deleted <main>/.claude/worktrees/<name> still has <main> as a prefix, so
    # owner() would quietly file the session under the main worktree with the
    # other hundred. Name the dead one instead.
    function dead(cwd,   rest, seg) {
      if (substr(cwd, 1, length(nr) + 1) != nr "/") return ""
      rest = substr(cwd, length(nr) + 2)
      seg = rest; sub(/\/.*$/, "", seg)
      if (seg == "" || islive(nr "/" seg)) return ""
      return seg
    }
    function base(p) { sub(/\/$/, "", p); sub(/^.*\//, "", p); return p }
    FILENAME == ef { lim[$1] = $2 + 0; next }          # per-worktree overrides
    FILENAME == wl { wp[++nwt] = $2; next }
    {
      from = dead($1)
      if (from != "") {
        o = orph
      } else {
        o = owner($1)
        if (o == "") o = owner($5)
        # Only paths inside this repo become orphans; a session from another
        # repository is simply not ours to show.
        if (o == "") {
          if (substr($1, 1, length(mr) + 1) == mr "/") { o = orph; from = base($1) }
          else next
        }
      }
      if ($6 == "resum") {
        total[o]++
        cap = (o in lim) ? lim[o] : maxr
        if (total[o] > cap) next
        shown[o]++
      }
      print o, $2, $3, $4, $6, from
    }
    END {
      for (o in total) print o, total[o], shown[o] + 0 > cf
    }
  ' "$expand_file" "$wtlist" "$sessions_file" > "$owned_file"
}

# Historical (resumable) sessions: Claude Code exposes no non-interactive
# listing, so we only *count* the transcript files it keeps per project dir.
# Read-only hint; `claude --resume` stays the thing that actually resumes.
history_count() {
  [ "$WANT_SESSIONS" -eq 1 ] || { printf 0; return; }
  [ -d "$CLAUDE_PROJECTS" ] || { printf 0; return; }
  local slug dir
  slug=$(printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g')
  dir="$CLAUDE_PROJECTS/$slug"
  [ -d "$dir" ] || { printf 0; return; }
  printf '%s' "$(find "$dir" -maxdepth 1 -name '*.jsonl' -type f 2>/dev/null | wc -l | tr -d ' ')"
}

session_badge() {  # $1 = worktree path
  local live hist
  live=$(awk -F'\t' -v p="$1" '$1==p && $5=="live"{n++} END{print n+0}' "$owned_file" 2>/dev/null)
  hist=$(history_count "$1")
  if [ "${live:-0}" -gt 0 ]; then
    printf '● %s live' "$live"
  elif [ "${hist:-0}" -gt 0 ]; then
    printf '◌ %s resumable' "$hist"
  fi
}

# ------------------------------------------------------- git status ---------
# One `git status --porcelain=v2 --branch` per worktree yields both numbers:
# the changed files and the ahead/behind counts against the upstream. Measured
# at 40-250 ms on a large repo; -S / ZRUSH_STATUS=0 skips it.
#
# Prints "<changed>\t<untracked>\t<ahead>\t<behind>\t<has-upstream>".
git_counts() {  # $1 = worktree path
  git -C "$1" status --porcelain=v2 --branch 2>/dev/null | awk '
    /^# branch\.ab /  { a = $3 + 0; b = -($4 + 0); up = 1 }
    /^[12u] /         { c++ }        # 1=changed 2=renamed/copied u=unmerged
    /^\? /            { n++ }
    END { printf "%d\t%d\t%d\t%d\t%d", c+0, n+0, a+0, b+0, up+0 }
  '
}

# Compact, plain text (pad() counts characters, so no colour in here).
#   ~3  changed tracked files      ?1  untracked
#   ↑2  commits ahead of upstream  ↓1  behind        ⚠  no upstream at all
status_badge() {  # $1 = worktree path
  [ "$ZRUSH_STATUS" != "0" ] || return 0
  local c n a b up out="" hit
  # Cached for the whole refresh: a fold redraws the menu and must not pay for
  # four `git status` again. The leading "-" makes an empty badge a cache hit.
  hit=$(awk -F'\t' -v p="$1" '$1==p{print $2; exit}' "$status_file" 2>/dev/null)
  [ -n "$hit" ] && { printf '%s' "${hit#-}"; return 0; }
  IFS=$'\t' read -r c n a b up < <(git_counts "$1")
  [ "${c:-0}" -gt 0 ] && out="$out ~$c"
  [ "${n:-0}" -gt 0 ] && out="$out ?$n"
  if [ "${up:-0}" -eq 0 ]; then
    out="$out ⚠"
  else
    [ "${a:-0}" -gt 0 ] && out="$out ↑$a"
    [ "${b:-0}" -gt 0 ] && out="$out ↓$b"
  fi
  out="${out# }"
  printf '%s\t-%s\n' "$1" "$out" >> "$status_file" 2>/dev/null
  printf '%s' "$out"
}

# Sessions that are no longer running but can still be resumed. Claude Code
# offers no non-interactive listing for them, so this reads the transcripts it
# keeps -- best effort, and bounded: only the newest $ZRUSH_RESUMABLE_SCAN files
# are examined, and at most $ZRUSH_RESUMABLE_MAX land under any one worktree.
# Nothing here resumes anything; `claude --resume <id>` still does that.
refresh_resumable() {
  [ "$WANT_SESSIONS" -eq 1 ] || return 0
  [ "${ZRUSH_RESUMABLE_MAX:-0}" != "0" ] || return 0
  [ -d "$CLAUDE_PROJECTS" ] || return 0
  have jq || return 0

  local -a dirs=()
  local d p f id meta title ecwd mt ts rest scan seen
  # Project dirs that can hold this repo's sessions: the main worktree's slug
  # and everything filed under it (linked worktrees, `claude --worktree`),
  # plus each worktree's own slug for worktrees kept outside the repo.
  for d in "$CLAUDE_PROJECTS/$(slugify "$main_root")"*; do
    [ -d "$d" ] && dirs+=("$d")
  done
  while IFS=$'\t' read -r _ p; do
    [ -n "$p" ] || continue
    d="$CLAUDE_PROJECTS/$(slugify "$p")"
    [ -d "$d" ] || continue
    case " ${dirs[*]} " in *" $d "*) ;; *) dirs+=("$d") ;; esac
  done < "$wtlist"
  [ "${#dirs[@]}" -gt 0 ] || return 0

  # Expanding a worktree lifts the cap: the rows it wants may sit well past
  # the newest $ZRUSH_RESUMABLE_SCAN transcripts of the repo.
  scan="$ZRUSH_RESUMABLE_SCAN"
  [ -s "$expand_file" ] && scan=1000000

  # The ids already listed as live, gathered once: a grep per transcript costs
  # more than the whole scan.
  local seen
  seen=$(cut -f2 "$sessions_file" 2>/dev/null | tr '\n' ' ')

  while IFS=' ' read -r mt f; do
    [ -n "$f" ] || continue
    id=${f##*/}; id=${id%.jsonl}
    is_uuid "$id" || continue
    case " $seen " in *" $id "*) continue ;; esac
    meta=$(session_meta_file "$f" "$id" "m$mt") || continue
    title=${meta%%$'\t'*}
    rest=${meta#*$'\t'}; ecwd=${rest%%$'\t'*}; ts=${rest#*$'\t'}
    case "$ts" in ''|*[!0-9]*) ts="$mt" ;; esac
    [ -n "$ecwd" ] || continue
    [ -n "$title" ] || title="${id:0:8}"
    if [ "${#title}" -gt "$ZRUSH_TITLE_WIDTH" ]; then
      title="${title:0:$((ZRUSH_TITLE_WIDTH - 1))}…"
    fi
    seen="$seen $id"
    printf '%s\t%s\t%s\tresumable %s\t%s\tresum\t%s\n' \
      "$ecwd" "$id" "$title" "$(age_of "${ts:-0}")" "$ecwd" "${ts:-0}" >> "$sessions_file"
  done < <(mtime_list "${dirs[@]}" | sort -rn | head -n "$scan")
}

# ------------------------------------------------------ collect worktrees ---
# Parse porcelain output into "$wtlist": <label>\t<path>
wt_path=""; wt_branch=""; wt_flags=""
flush_wt() {
  [ -n "$wt_path" ] || return 0
  local label="$wt_branch"
  [ -n "$wt_flags" ] && label="$label $wt_flags"
  # The primary worktree: the one holding .git, and the one git refuses to
  # remove. "[root]" says that without repeating the branch name.
  [ "$wt_path" = "$main_root" ] && label="$label [root]"
  printf '%s\t%s\n' "$label" "$wt_path" >> "$wtlist"
  wt_path=""; wt_branch=""; wt_flags=""
}

collect_worktrees() {
  : > "$wtlist"
  wt_path=""; wt_branch=""; wt_flags=""
  while IFS= read -r line; do
    case "$line" in
      worktree\ *) flush_wt; wt_path="${line#worktree }" ;;
      branch\ *)   wt_branch="${line#branch refs/heads/}" ;;
      detached)    wt_branch="(detached)" ;;
      bare)        wt_branch="(bare)" ;;
      locked*)     wt_flags="$wt_flags 🔒" ;;
      prunable*)   wt_flags="$wt_flags ⚠" ;;
    esac
  done < <(git -C "$repo_dir" worktree list --porcelain)
  flush_wt
}

# printf pads by bytes, so pad by characters ourselves: worktree labels and
# session names routinely carry accents and the ●/├─ glyphs.
pad() {  # $1 = string, $2 = target width
  local s="$1" n="$2" fill="" k=$(( $2 - ${#1} ))
  [ "$k" -gt 0 ] && printf -v fill '%*s' "$k" ''
  printf '%s%s' "$s" "$fill"
}

# $1 = full | more | render
#   full    re-probe everything (the default)
#   more    keep the live sessions, re-scan transcripts to pull in older ones
#   render  no probing at all, just lay the rows out again (folding)
build_menu() {
  local mode="${1:-full}"
  collect_worktrees
  [ -s "$wtlist" ] || die "no worktrees found in $repo_dir"
  [ "$mode" = "render" ] || refresh_resumable
  # Newest first, live and resumable interleaved: the cap below then keeps the
  # most recent ones, and the rows come out in date order for free.
  if [ -s "$sessions_file" ]; then
    sort -t$'\t' -k7,7nr -o "$sessions_file" "$sessions_file" 2>/dev/null || true
  fi
  assign_sessions

  local -a r_type=() r_path=() r_id=() r_c1=() r_c2=() r_c3=()
  local label path n i id name status kind origin dot mark tree hidden fold _owner

  while IFS=$'\t' read -r label path; do
    [ -n "$path" ] || continue

    n=$(awk -F'\t' -v p="$path" '$1==p{n++} END{print n+0}' "$owned_file" 2>/dev/null)

    # Resumables held back by the per-worktree cap get a "[...more]" row.
    hidden=$(awk -F'\t' -v p="$path" '$1==p{print ($2+0)-($3+0); exit}' "$counts_file" 2>/dev/null)
    [ "${hidden:-0}" -gt 0 ] || hidden=0

    # ▾ unfolded, ▸ folded, blank when there is nothing under it. The two
    # columns are always there so the labels stay aligned.
    if [ "${n:-0}" -eq 0 ]; then fold="  "
    elif is_collapsed "$path"; then fold="▸ "
    else fold="▾ "
    fi

    r_type+=("wt"); r_path+=("$path"); r_id+=("")
    r_c1+=("$fold$label"); r_c2+=("$(session_badge "$path")"); r_c3+=("$(status_badge "$path")")

    [ "${n:-0}" -gt 0 ] || continue
    is_collapsed "$path" && continue
    i=0
    while IFS=$'\t' read -r _owner id name status kind origin; do
      i=$((i+1))
      if [ "$i" -eq "$n" ] && [ "$hidden" -eq 0 ]; then tree="└─"; else tree="├─"; fi
      # ● running, ◌ resumable but not running
      [ "$kind" = "live" ] && dot="●" || dot="◌"
      mark="$status"
      r_type+=("session"); r_path+=("$path"); r_id+=("$id")
      r_c1+=("   $tree $dot $name"); r_c2+=("$mark"); r_c3+=("")
    done < <(awk -F'\t' -v p="$path" '$1==p' "$owned_file")

    if [ "$hidden" -gt 0 ]; then
      r_type+=("more"); r_path+=("$path"); r_id+=("")
      r_c1+=("   └─ […more]"); r_c2+=("+$hidden older"); r_c3+=("")
    fi
  done < "$wtlist"

  # Sessions whose worktree is gone. They would otherwise land under the main
  # worktree by prefix and vanish among its hundred, so they get their own
  # node and each row says which worktree it was written for.
  n=$(awk -F'\t' -v p="$ORPHANS" '$1==p{n++} END{print n+0}' "$owned_file" 2>/dev/null)
  if [ "${n:-0}" -gt 0 ]; then
    hidden=$(awk -F'\t' -v p="$ORPHANS" '$1==p{print ($2+0)-($3+0); exit}' "$counts_file" 2>/dev/null)
    [ "${hidden:-0}" -gt 0 ] || hidden=0
    if is_collapsed "$ORPHANS"; then fold="▸ "; else fold="▾ "; fi

    r_type+=("orphans"); r_path+=("$ORPHANS"); r_id+=("")
    r_c1+=("${fold}orphaned sessions"); r_c2+=("◌ $n"); r_c3+=("")

    if ! is_collapsed "$ORPHANS"; then
      i=0
      while IFS=$'\t' read -r _owner id name status kind origin; do
        i=$((i+1))
        if [ "$i" -eq "$n" ] && [ "$hidden" -eq 0 ]; then tree="└─"; else tree="├─"; fi
        [ "$kind" = "live" ] && dot="●" || dot="◌"
        mark="$status"
        [ -n "$origin" ] && mark="$mark  $origin"
        r_type+=("orphan"); r_path+=("$ORPHANS"); r_id+=("$id")
        r_c1+=("   $tree $dot $name"); r_c2+=("$mark"); r_c3+=("")
      done < <(awk -F'\t' -v p="$ORPHANS" '$1==p' "$owned_file")
      if [ "$hidden" -gt 0 ]; then
        r_type+=("more"); r_path+=("$ORPHANS"); r_id+=("")
        r_c1+=("   └─ […more]"); r_c2+=("+$hidden older"); r_c3+=("")
      fi
    fi
  fi

  # Last row: create a worktree. No path, so every consumer keys off type.
  r_type+=("new"); r_path+=(""); r_id+=("")
  r_c1+=("  + new worktree…"); r_c2+=(""); r_c3+=("")

  local w=0 v=0 x=0 k col loc
  for k in "${!r_c1[@]}"; do
    [ "${#r_c1[$k]}" -gt "$w" ] && w=${#r_c1[$k]}
    [ "${#r_c2[$k]}" -gt "$v" ] && v=${#r_c2[$k]}
    [ "${#r_c3[$k]}" -gt "$x" ] && x=${#r_c3[$k]}
  done

  : > "$menu"
  for k in "${!r_c1[@]}"; do
    case "${r_type[$k]}" in
      wt)  col=$'\033[1;36m'; loc="${r_path[$k]}" ;;
      new)     col=$'\033[1;32m'; loc="$new_root/<name>" ;;
      more)    col=$'\033[2;35m'; loc="" ;;
      orphans) col=$'\033[1;31m'; loc="worktree gone" ;;
      orphan)  col=$'\033[0;35m'; loc="" ;;
      *)   col=$'\033[0;35m'; loc="" ;;
    esac
    printf '%s%s\033[0m  \033[33m%s\033[0m  \033[0;32m%s\033[0m  \033[2m%s\033[0m\t%s\t%s\t%s\n' \
      "$col" "$(pad "${r_c1[$k]}" "$w")" "$(pad "${r_c2[$k]}" "$v")" \
      "$(pad "${r_c3[$k]}" "$x")" \
      "$loc" "${r_path[$k]}" "${r_type[$k]}" "${r_id[$k]}" >> "$menu"
  done
}

# ---------------------------------------------------------------- actions ---
# Zed 1.20.2 offers no way to focus the window that already holds a project:
# `cli_default_open_behavior` is either "new_window" (a second window on the
# same path) or "existing_window" (every worktree piled into the focused
# window's sidebar). A `<path>/.` subpath appeared to focus, but four calls in
# a row produced four windows, so it does not. Measured, not assumed.
#
# Nested worktrees have a further catch: while the parent project is open in
# Zed, `zed <parent>/.claude/worktrees/<name>` is swallowed by the parent's
# window. Only the -n flag reliably gives such a worktree its own window --
# at the cost of a new window on every open. See ZRUSH_EDITOR / ZRUSH_EDITOR_CMD.
open_editor() {  # $1 = worktree path
  have "${ZRUSH_EDITOR_CMD[0]}" \
    || { warn "${ZRUSH_EDITOR_CMD[0]} not found (install its shell command)"; return 1; }
  "${ZRUSH_EDITOR_CMD[@]}" "$1" || warn "could not open $1"
}

# These two run inside fzf's execute(), which hands over the whole terminal,
# so a nested fzf is fine -- and a list you arrow through beats a y/n typed
# blind at a prompt you cannot see the context of.

# Remote default branch, the base every new branch is cut from. No fetch:
# zrush never touches the network.
default_base() {
  local b
  b=$(git -C "$repo_dir" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) \
    && [ -n "$b" ] && { printf '%s' "$b"; return 0; }
  for b in origin/main origin/master; do
    git -C "$repo_dir" rev-parse --verify --quiet "$b" >/dev/null 2>&1 \
      && { printf '%s' "$b"; return 0; }
  done
  return 1
}

# Ask for a name and add the worktree under $new_root. An existing branch is
# checked out as-is; a new one is cut from the remote default branch.
# Prints the new path on stdout, everything else goes to stderr.
create_worktree() {  # $1 = branch name, already chosen by the footer
  local name dest base
  name="${1:-}"
  name="${name#"${name%%[![:space:]]*}"}"
  name="${name%"${name##*[![:space:]]}"}"
  [ -n "$name" ] || return 1
  git check-ref-format --branch "$name" >/dev/null 2>&1 \
    || { warn "invalid branch name: $name"; return 1; }

  dest="$new_root/${name##*/}"
  [ -e "$dest" ] && { warn "already there: $dest"; return 1; }
  mkdir -p "$new_root" || { warn "could not create $new_root"; return 1; }

  if git -C "$repo_dir" show-ref --verify --quiet "refs/heads/$name"; then
    git -C "$repo_dir" worktree add "$dest" "$name" >&2 || return 1
  else
    base=$(default_base) || { warn "no remote default branch (origin/HEAD)"; return 1; }
    printf '%s: branching %s off %s\n' "$PROG" "$name" "$base" >&2
    # --no-track: the branch starts at $base but owns no upstream, so a later
    # `git push -u origin HEAD` sets the right one instead of pointing at main.
    git -C "$repo_dir" worktree add --no-track -b "$name" "$dest" "$base" >&2 || return 1
  fi
  printf '%s' "$dest"
}

# Delete one session's transcript, wherever Claude Code filed it, plus the
# sidecar directory and our cached title. Prints how many files went.
purge_session() {  # $1 = session id
  local f dir gone=0
  [ -n "$1" ] || return 1
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    rm -f "$f" && gone=$((gone+1))
    dir="${f%.jsonl}"
    [ -d "$dir" ] && rm -rf "$dir"
  done < <(find "$CLAUDE_PROJECTS" -mindepth 2 -maxdepth 2 -name "$1.jsonl" 2>/dev/null)
  rm -f "$CACHE_DIR/$1" 2>/dev/null
  printf '%s' "$gone"
}

# ctrl-d on a session row: delete that one conversation. The worktree stays.
delete_session() {  # $1 = id, $2 = worktree path, $3 = title, $4 = kind
  # The footer asked already; this only does the work.
  local id="$1" p="$2" title="$3" kind="$4" ans gone bound
  [ -n "$id" ] || return 1
  if [ "$kind" = "live" ]; then
    warn "session $id is running; stop it first"
    return 1
  fi

  gone=$(purge_session "$id")
  if [ "${gone:-0}" -eq 0 ]; then
    warn "no transcript found for $id"
    return 1
  fi
  # Drop the association if this worktree pointed at the session just deleted.
  # An orphan has no worktree, so there is nothing to clear.
  if [ -n "$p" ] && [ -d "$p" ]; then
    bound=$(state_read "$p" 2>/dev/null) || bound=""
    [ "$bound" = "$id" ] && state_clear "$p"
  fi
  printf '%s: deleted %s file(s) for %s\n' "$PROG" "$gone" "${id:0:8}" >&2
  return 0
}

# Remove a worktree and, if asked, the Claude transcripts of the sessions
# that belong to it. Three answers, because "delete the worktree" and "delete
# the conversations that happened in it" are not the same decision.
#
# Deleting a session means deleting Claude Code's own transcript file under
# ~/.claude/projects/. Running sessions are never touched.
delete_worktree() {  # $1 = worktree path, $2 = y (with sessions) | n (without)
  local p="$1" rows n live ans hdr id kind gone=0
  [ -n "$p" ] || return 1
  if [ "$p" = "$main_root" ]; then
    warn "refusing to remove the main worktree"
    return 1
  fi

  rows=$(awk -F'\t' -v w="$p" '$1==w{print $2"\t"$5}' "$owned_file" 2>/dev/null)
  n=$(printf '%s' "$rows" | grep -c . 2>/dev/null) || n=0
  live=$(printf '%s' "$rows" | awk -F'\t' '$2=="live"{k++} END{print k+0}')

  # $2 is the answer the footer already collected: y also deletes the
  # sessions, n keeps them. Nothing is asked here any more.
  ans="${2:-}"
  case "$ans" in y|n) ;; *) return 1 ;; esac

  git -C "$repo_dir" worktree remove "$p" >&2 || {
    warn "worktree kept; use 'git worktree remove --force' yourself if you mean it"
    return 1
  }

  [ "$ans" = "y" ] || return 0
  while IFS=$'\t' read -r id kind; do
    [ -n "$id" ] || continue
    if [ "$kind" = "live" ]; then
      warn "session $id is running; stop it first, transcript kept"
      continue
    fi
    gone=$(( gone + $(purge_session "$id") ))
  done <<EOF
$rows
EOF
  [ "$gone" -gt 0 ] && printf '%s: deleted %s transcript(s)\n' "$PROG" "$gone" >&2
  return 0
}

# Start claude in a terminal of its own and come straight back to the picker.
#
# macOS has no way to hand a command to a specific terminal without
# AppleScript, but `open` on an executable *.command file starts whichever app
# owns that file type and runs it. So: write a throwaway script, open it, let
# it delete itself when claude exits.
#
# The script also drops the CLAUDE_CODE_* markers, for the case where
# ZRUSH_TERMINAL is a real command that inherits this environment rather than
# `open`, which starts from a clean one.
run_claude_term() {  # $1 = worktree path, rest = extra claude args
  local p="$1"; shift
  have claude || { warn "claude CLI not found"; return 1; }
  local cbin dir script
  cbin=$(command -v claude) || return 1
  dir=$(mktemp -d "${TMPDIR:-/tmp}/zrush-term.XXXXXX") || { warn "mktemp failed"; return 1; }
  script="$dir/session.command"
  {
    printf '#!/bin/sh\n'
    printf 'unset CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_SESSION_ID \\\n'
    printf '      CLAUDE_CODE_SESSION_ATTENDED CLAUDE_CODE_MESSAGING_SOCKET \\\n'
    printf '      CLAUDE_CODE_MESSAGING_TOKEN CLAUDE_CODE_ENTRYPOINT \\\n'
    printf '      CLAUDE_PID CLAUDECODE CLAUDE_EFFORT AI_AGENT\n'
    printf 'cd %q || exit 1\n' "$p"
    printf '%q' "$cbin"; [ "$#" -gt 0 ] && printf ' %q' "$@"; printf '\n'
    printf 'rm -rf %q\n' "$dir"
  } > "$script" || { rm -rf "$dir"; return 1; }
  chmod +x "$script"
  "${ZRUSH_TERMINAL[@]}" "$script" \
    || { warn "${ZRUSH_TERMINAL[0]} could not open a terminal"; rm -rf "$dir"; return 1; }
}

# --show: what the preview pane draws for the highlighted row. A worktree
# still gets its git status; a session gets the tail of the conversation,
# which is the thing you actually want to see before resuming one. fzf's
# preview is output-only -- no keystroke reaches it -- so this is as close to
# "Claude in the preview" as fzf can get.
if [ "$SHOW" -eq 1 ]; then
  case "$DO_TYPE" in
    session|orphan)
      [ -n "$DO_ID" ] || exit 0
      f=$(find "$CLAUDE_PROJECTS" -mindepth 2 -maxdepth 2 -name "$DO_ID.jsonl" 2>/dev/null | head -1)
      [ -n "$f" ] || { printf 'no transcript for %s\n' "${DO_ID:0:8}"; exit 0; }
      printf '\033[2m%s\033[0m\n\n' "${f#$CLAUDE_PROJECTS/}"
      tail -n "$TAIL_LINES" "$f" | jq -Rr '
        fromjson? // empty
        | select(.type=="user" or .type=="assistant")
        | (.message.content // empty) as $c
        | if ($c|type)=="string" then {r:.type, t:$c}
          elif ($c|type)=="array" then {r:.type, t:([$c[] | select(.type=="text") | .text] | join(" "))}
          else empty end
        | select(.t != "" and (.t|startswith("<")|not))
        | "\(.r)\t\(.t | gsub("[\n\t]+";" ") | gsub("  +";" "))"' 2>/dev/null \
      | tail -n "${ZRUSH_PREVIEW_TURNS:-14}" \
      | awk -F'\t' -v w="${FZF_PREVIEW_COLUMNS:-60}" '
          { c = ($1 == "user") ? "\033[1;36m" : "\033[0;37m"
            tag = ($1 == "user") ? "you" : "  ·"
            t = $2
            while (length(t) > 0) {
              printf "%s%s\033[0m %s\n", c, tag, substr(t, 1, w - 5)
              t = substr(t, w - 4); tag = "   "
            }
            print "" }'
      ;;
    wt)
      [ -d "$DO_PATH" ] || exit 0
      git -C "$DO_PATH" status --short --branch 2>/dev/null | head -15
      echo
      git -C "$DO_PATH" log --oneline --decorate -n 10 2>/dev/null
      ;;
  esac
  exit 0
fi

# --ask / --answer: the two halves of a question posed in the footer.
#
# fzf cannot draw a dialog over its own list, but it can rewrite the footer
# and swap which keys are live. --ask prints the fzf actions that put the
# question up and remembers what y and n should do; --answer carries it out.
# Nothing hands the terminal to another process, so the list never moves.
# y-action \t n-action \t path \t type \t id. "-" stands for "nothing to do":
# tab is IFS whitespace, so `read` would swallow an empty field and shift
# every column after it.
CONFIRM_FILE="$tmpdir/confirm"
LAST_FILE="$tmpdir/last"           # whatever the last action printed

if [ -n "$ASK" ]; then
  case "$ASK" in
    delete)
      case "$DO_TYPE" in
        session|orphan)
          t=$(awk -F'\t' -v i="$DO_ID" '$2==i{print $3; exit}' "$owned_file" 2>/dev/null)
          printf 'delete-session\t-\t%s\t%s\t%s\n' "$DO_PATH" "$DO_TYPE" "$DO_ID" > "$CONFIRM_FILE"
          printf 'change-prompt(delete? )+change-footer(delete  %s  for good?    y  yes    esc  cancel)' \
                 "${t:-${DO_ID:0:8}}"
          ;;
        wt)
          [ "$DO_PATH" = "$main_root" ] && { printf 'change-footer(the main worktree cannot be removed -- press any key)'; exit 0; }
          n=$(awk -F'\t' -v w="$DO_PATH" '$1==w{k++} END{print k+0}' "$owned_file" 2>/dev/null)
          live=$(awk -F'\t' -v w="$DO_PATH" '$1==w && $5=="live"{k++} END{print k+0}' "$owned_file" 2>/dev/null)
          if [ "${n:-0}" -eq 0 ]; then
            printf 'delete-wt\t-\t%s\twt\t-\n' "$DO_PATH" > "$CONFIRM_FILE"
            printf 'change-prompt(remove? )+change-footer(remove worktree  %s ?    y  yes    esc  cancel)' "${DO_PATH##*/}"
          else
            printf 'delete-all\tdelete-wt\t%s\twt\t-\n' "$DO_PATH" > "$CONFIRM_FILE"
            extra=""; [ "${live:-0}" -gt 0 ] && extra=", $live running"
            printf 'change-prompt(remove? )+change-footer(remove  %s  and its %s session%s?    y  yes, delete them too    n  no, keep them    esc  cancel)' \
                   "${DO_PATH##*/}" "$n$extra" "$( [ "$n" -gt 1 ] && printf s )"
          fi
          ;;
        *) printf 'ignore'; exit 0 ;;
      esac
      printf '+rebind(y,n,c)+unbind(ctrl-d,ctrl-w,ctrl-o,ctrl-l,left,right)\n'
      ;;

    branch)
      case "$DO_TYPE" in
        more|orphans) printf 'ignore'; exit 0 ;;
      esac
      printf 'branch\t-\t%s\t%s\t%s\n' "$DO_PATH" "$DO_TYPE" "$DO_ID" > "$CONFIRM_FILE"
      printf 'change-prompt(branch> )+change-footer(type a new branch name, or pick one below.    enter  create the worktree    esc  cancel)'
      printf '+reload(git -C %q for-each-ref --sort=-committerdate --format=%%\(refname:short\) refs/heads)' "$repo_dir"
      printf '+unbind(ctrl-d,ctrl-w,ctrl-o,ctrl-l,left,right)\n'
      ;;

    enter)
      # In branch mode the list holds branch names, so the typed query or the
      # highlighted line is the answer; otherwise dispatch on the row type.
      if [ "${FZF_PROMPT:-}" = "branch> " ]; then
        name="${Q_CUR:-$Q_TEXT}"
        printf 'execute-silent(%q branch %q)+transform(%q done)+reload(%q)\n' \
               "$ANS_SH" "$name" "$ASK_SH" "$RELOAD_SH"
        exit 0
      fi
      case "$DO_TYPE" in
        more)       printf 'reload(%q --more %q)\n' "$ACT_SH" "$DO_PATH" ;;
        new|orphan) exec "$0" --state "$tmpdir" --repo "$repo_dir" --ask branch \
                         --path "$DO_PATH" --type "$DO_TYPE" --id "$DO_ID" ;;
        orphans)    printf 'ignore\n' ;;
        *)          printf 'accept\n' ;;
      esac
      ;;
    # After an action: restore the normal bindings and report what happened.
    # execute-silent does NOT shield the screen -- anything the command prints
    # lands on the terminal and corrupts the frame -- so the command writes to
    # a file and its last line comes back here, as footer text.
    done)
      msg=""
      if [ -s "$LAST_FILE" ]; then
        msg=$(grep -v '^[[:space:]]*$' "$LAST_FILE" | tail -1 \
              | tr -d '()' | cut -c1-120)
      fi
      : > "$LAST_FILE"
      printf 'change-prompt(worktree> )+change-footer(%s)' "${msg:-$FOOTER}"
      printf '+unbind(y,n,c)+rebind(ctrl-d,ctrl-w,ctrl-o,ctrl-l,left,right)\n'
      ;;
    *) printf 'ignore\n' ;;
  esac
  exit 0
fi

if [ -n "$ANSWER" ]; then
  [ -f "$CONFIRM_FILE" ] || exit 0
  IFS=$'\t' read -r ya na cpath ctype cid < "$CONFIRM_FILE"
  : > "$CONFIRM_FILE"
  [ "$ya" = "-" ] && ya=""
  [ "$na" = "-" ] && na=""
  [ "$cid" = "-" ] && cid=""
  [ "$ctype" = "-" ] && ctype=""
  case "$ANSWER" in
    y) act="$ya" ;;
    n) act="$na" ;;
    branch)
      [ -n "$DO_NAME" ] || exit 0
      exec "$0" --state "$tmpdir" --repo "$repo_dir" --do newwt \
                --path "$cpath" --type "$ctype" --id "$cid" --name "$DO_NAME"
      ;;
    *) exit 0 ;;
  esac
  [ -n "$act" ] || exit 0
  exec "$0" --state "$tmpdir" --repo "$repo_dir" --do "$act" \
            --path "$cpath" --type "$ctype" --id "$cid"
fi

# --do <action>: the interactive half of a key, run by fzf's execute() so the
# picker stays up. Everything it prints goes to the terminal, never to the
# list; the binding pairs it with a reload.
if [ -n "$DO_ACTION" ]; then
  case "$DO_ACTION" in
    delete-session)
      title=$(awk -F'\t' -v i="$DO_ID" '$2==i{print $3; exit}' "$owned_file" 2>/dev/null)
      kind=$(awk -F'\t' -v i="$DO_ID" '$2==i{print $5; exit}' "$owned_file" 2>/dev/null)
      [ "$DO_TYPE" = "orphan" ] && DO_PATH=""
      delete_session "$DO_ID" "$DO_PATH" "${title:-${DO_ID:0:8}}" "$kind" || true
      ;;
    delete-all)  delete_worktree "$DO_PATH" y || true ;;
    delete-wt)   delete_worktree "$DO_PATH" n || true ;;
    newwt)
      if newp=$(create_worktree "$DO_NAME") && [ -n "$newp" ]; then
        if { [ "$DO_TYPE" = "session" ] || [ "$DO_TYPE" = "orphan" ]; } && [ -n "$DO_ID" ]; then
          state_write "$newp" "$DO_ID"
        else
          state_clear "$newp"
        fi
        open_editor "$newp"
      fi
      ;;
    *) die "unknown --do action: $DO_ACTION" ;;
  esac
  exit 0
fi

# --sessions <path>: one line per session of that worktree, "<id>\t<label>",
# newest first. zrush_session -l turns this into a picker, so the choice of
# which conversation to resume can also be made from the editor's terminal.
if [ -n "$SESSIONS_OF" ]; then
  refresh_sessions
  build_menu full
  awk -F'\t' -v w="$SESSIONS_OF" '
    $1 == w { printf "%s\t%s %s  (%s)\n", $2, ($5 == "live" ? "●" : "◌"), $3, $4 }
  ' "$owned_file"
  exit 0
fi

# --menu: print the menu once, for fzf's reload binding, and leave.
if [ "$MENU_ONLY" -eq 1 ]; then
  [ -n "$FOLD_PATH" ]   && collapse_set   "$FOLD_PATH"
  [ -n "$UNFOLD_PATH" ] && collapse_unset "$UNFOLD_PATH"
  if [ -n "$MORE_PATH" ]; then
    cur=$(awk -F'\t' -v p="$MORE_PATH" '$1==p{print $2; exit}' "$expand_file" 2>/dev/null)
    [ -n "$cur" ] || cur="$ZRUSH_RESUMABLE_MAX"
    awk -F'\t' -v p="$MORE_PATH" '$1!=p' "$expand_file" > "$expand_file.new" 2>/dev/null
    mv -f "$expand_file.new" "$expand_file" 2>/dev/null
    printf '%s\t%s\n' "$MORE_PATH" "$(( cur + ZRUSH_MORE_STEP ))" >> "$expand_file"
  fi
  # A reload resets fzf's cursor to the top, so leave it the row the key was
  # pressed on: the worktree for a fold, the "[...more]" row for an unfold
  # (or that worktree's last row once nothing is left to unfold).
  pos_of() {  # $1 = worktree path, $2 = row type
    awk -F'\t' -v p="$1" -v t="$2" '$2==p && $3==t {print NR; exit}' "$menu"
  }
  pos_node() {  # the worktree row, or the orphaned-sessions node
    local at; at=$(pos_of "$1" wt); [ -n "$at" ] || at=$(pos_of "$1" orphans)
    printf '%s' "$at"
  }
  if [ "$RENDER_ONLY" -eq 1 ]; then
    # State built by the parent: only lay the rows out again. `more` still
    # needs the transcript scan, the rest costs one `git worktree list`.
    [ -n "$MORE_PATH" ] && build_menu more || build_menu render
  else
    refresh_sessions
    build_menu full
  fi
  for _p in "$FOLD_PATH" "$UNFOLD_PATH"; do
    [ -n "$_p" ] && pos_node "$_p" > "$tmpdir/pos"
  done
  if [ -n "$MORE_PATH" ]; then
    # Once everything is unfolded the "[...more]" row is gone; park the cursor
    # on the worktree rather than on its last session, so the next enter does
    # not silently bind a session nobody aimed at.
    _at=$(pos_of "$MORE_PATH" more)
    [ -n "$_at" ] || _at=$(pos_node "$MORE_PATH")
    [ -n "$_at" ] && printf '%s' "$_at" > "$tmpdir/pos"
  fi
  cat "$menu"
  exit 0
fi

# fzf runs a bind's command through sh, so hand it a script instead of a
# quoted one-liner: no escaping to get wrong, whatever the repo path holds.
{
  printf '#!/bin/sh\nexec'
  printf ' %q' "$SELF" --menu --repo "$repo_dir"
  [ "$WANT_SESSIONS" -eq 0 ] && printf ' -n'
  printf '\n'
} > "$reload_sh" && chmod +x "$reload_sh"

# Folding and "[...more]" go through fzf's reload rather than quitting it:
# tearing the picker down and starting it again costs far more than the
# redraw. $1 $2 are --fold/--unfold/--more and the path, quoted by fzf.
{
  printf '#!/bin/sh\nexec'
  printf ' %q' "$SELF" --menu --render --state "$tmpdir" --repo "$repo_dir"
  [ "$WANT_SESSIONS" -eq 0 ] && printf ' -n'
  [ "$ZRUSH_STATUS" = "0" ] && printf ' -S'
  printf ' "$1" "$2"\n'
} > "$act_sh" && chmod +x "$act_sh"

# The interactive half, run by execute(): "$1 $2 $3 $4" are the action, the
# path, the row type and the session id, all quoted by fzf.
{
  printf '#!/bin/sh\nexec'
  printf ' %q' "$SELF" --state "$tmpdir" --repo "$repo_dir"
  printf ' --do "$1" --path "$2" --type "$3" --id "$4"\n'
} > "$do_sh" && chmod +x "$do_sh"

# transform() calls this and feeds our stdout back to fzf as actions.
{
  printf '#!/bin/sh\nexec'
  printf ' %q' "$SELF" --state "$tmpdir" --repo "$repo_dir"
  printf ' --ask "$1" --path "$2" --type "$3" --id "$4" --query "$5" --current "$6"\n'
} > "$ask_sh" && chmod +x "$ask_sh"

# And this carries out whatever the footer just asked.
{
  printf '#!/bin/sh\nexec'
  printf ' %q' "$SELF" --state "$tmpdir" --repo "$repo_dir"
  printf ' --answer "$1" --name "$2" >%q 2>&1\n' "$tmpdir/last"
} > "$ans_sh" && chmod +x "$ans_sh"

# What the preview pane draws, per row type.
{
  printf '#!/bin/sh\nexec'
  printf ' %q' "$SELF" --state "$tmpdir" --repo "$repo_dir" --show
  printf ' --path "$1" --type "$2" --id "$3"\n'
} > "$show_sh" && chmod +x "$show_sh"

# fzf runs this after every reload; it prints a pos() action when the child
# left one behind, and nothing otherwise.
pos_sh="$tmpdir/posact"
cat > "$pos_sh" <<'POSEOF'
#!/bin/sh
p="$(dirname "$0")/pos"
[ -s "$p" ] || exit 0
printf 'pos(%s)' "$(cat "$p")"
rm -f "$p"
POSEOF
chmod +x "$pos_sh"

# Identity of the row the cursor sat on, so the next pass can go back to it:
# "<path>\t<type>\t<id>". Empty on the first pass.
cursor_key=""

# ------------------------------------------------------------- main loop ----
next_build=full
# Once the transcript scan has run uncapped, every resumable the repo has is
# already in $sessions_file: further "[...more]" presses only need a redraw.
# refresh_sessions truncates that file, so a full rebuild resets this.
scanned_all=0
while :; do
  case "$next_build" in
    full) refresh_sessions; : > "$status_file"; scanned_all=0 ;;
    more) : ;;                 # live list and git status still good
  esac
  build_menu "$next_build"
  next_build=full

  if [ "$LIST_ONLY" -eq 1 ]; then
    awk -F'\t' '{print $1}' "$menu"
    exit 0
  fi

  # Put the cursor back where it was. --sync makes sure the list is loaded
  # before `start` fires; a row that vanished just leaves the cursor on top.
  # No --height at all = fzf's full-screen mode (alternate screen).
  height_opt=()
  [ -n "$ZRUSH_FZF_HEIGHT" ] && height_opt=(--height="$ZRUSH_FZF_HEIGHT")

  pos_bind=()
  if [ -n "$cursor_key" ]; then
    at=$(awk -F'\t' -v k="$cursor_key" '$2"\t"$3"\t"$4==k{print NR; exit}' "$menu")
    [ -n "$at" ] && pos_bind=(--bind "start:pos($at)")
  fi

  # Asking happens in the footer, not in another window. fzf cannot draw a
  # dialog over its own list, but it can rewrite the footer and swap which
  # keys are live -- so the list stays exactly where it is, the row you aimed
  # at stays highlighted, and nothing hands the terminal to another process.
  # $FZF_PROMPT is the mode: "worktree> " normally, "delete? " or "branch> "
  # while a question is up. It is the one piece of state fzf exports back to
  # a transform, which is why the prompt carries it.
  restore="change-prompt(worktree> )+change-footer($FOOTER)+unbind(y,n,c)"
  restore="$restore+rebind(ctrl-d,ctrl-w,ctrl-o,ctrl-l,left,right)"

  sel=$(
    fzf --ansi --sync \
        --delimiter=$'\t' --with-nth=1 --id-nth=2,3,4 \
        ${height_opt[@]+"${height_opt[@]}"} --reverse --border \
        --prompt="worktree> " \
        --footer="$FOOTER" --footer-border=rounded \
        --expect=ctrl-o,ctrl-q \
        --bind="start:unbind(y,n,c)" \
        --bind="ctrl-l:reload($reload_sh)" \
        --bind="left:reload($act_sh --fold {2})" \
        --bind="right:reload($act_sh --unfold {2})" \
        --bind="load:transform($pos_sh)" \
        --bind="ctrl-d:transform($ask_sh delete {2} {3} {4})" \
        --bind="ctrl-w:transform($ask_sh branch {2} {3} {4})" \
        --bind="enter:transform($ask_sh enter {2} {3} {4} {q} {})" \
        --bind="y:execute-silent($ans_sh y)+transform($ask_sh done)+reload($reload_sh)" \
        --bind="n:execute-silent($ans_sh n)+transform($ask_sh done)+reload($reload_sh)" \
        --bind="c:$restore" \
        --bind="esc:transform:[ ! \"\$FZF_PROMPT\" = 'worktree> ' ] && echo \"$restore\" || echo abort" \
        ${pos_bind[@]+"${pos_bind[@]}"} \
        --preview="$show_sh {2} {3} {4}" \
        --preview-window=right:50%:wrap \
        < "$menu"
  )
  # Empty selection = esc / ctrl-c / no match -> leave zrush.
  [ -n "$sel" ] || break

  title=""; kind=""
  key=$(printf '%s\n' "$sel" | sed -n '1p')
  line=$(printf '%s\n' "$sel" | sed -n '2p')
  path=$(printf '%s' "$line"   | awk -F'\t' '{print $2}')
  rtype=$(printf '%s' "$line"  | awk -F'\t' '{print $3}')
  sessid=$(printf '%s' "$line" | awk -F'\t' '{print $4}')
  [ "$key" = "ctrl-q" ] && break
  cursor_key=$(printf '%s\t%s\t%s' "$path" "$rtype" "$sessid")

  # The "[...more]" row is not an action: it raises this worktree's cap and
  # redraws, so enter after enter keeps unfolding it.
  if [ "$rtype" = "more" ]; then
    cur=$(awk -F'\t' -v p="$path" '$1==p{print $2; exit}' "$expand_file" 2>/dev/null)
    [ -n "$cur" ] || cur="$ZRUSH_RESUMABLE_MAX"
    awk -F'\t' -v p="$path" '$1!=p' "$expand_file" > "$expand_file.new" 2>/dev/null
    mv -f "$expand_file.new" "$expand_file" 2>/dev/null
    printf '%s\t%s\n' "$path" "$(( cur + ZRUSH_MORE_STEP ))" >> "$expand_file"
    if [ "$scanned_all" -eq 1 ]; then
      next_build=render        # the rows are already in hand, just show more
    else
      next_build=more          # first unfold: scan the transcripts uncapped
      scanned_all=1
    fi
    [ "$LOOP" -eq 1 ] || break
    continue
  fi

  # Rows handled entirely inside fzf (execute/reload): nothing to do here.
  case "$rtype" in new|orphan|orphans) [ "$LOOP" -eq 1 ] || break; continue ;; esac

  [ -n "$path" ] || break
  if [ ! -d "$path" ]; then
    warn "worktree path no longer exists: $path"
    continue
  fi

  if [ "$PRINT_ONLY" -eq 1 ]; then
    printf '%s\n' "$path"
    break
  fi

  case "$key" in
    ctrl-o) run_claude_term "$path" ;;
    # enter: a WORKTREE always means a new session -- the association is
    # dropped, and zrush_session starts a fresh claude. A SESSION means resume
    # that one: its id is written down for zrush_session to pick up.
    *)
      if [ "$rtype" = "session" ] && [ -n "$sessid" ]; then
        state_write "$path" "$sessid"
      else
        state_clear "$path"
      fi
      open_editor "$path"
      ;;
  esac

  [ "$LOOP" -eq 1 ] || break
done
