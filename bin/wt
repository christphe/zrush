#!/usr/bin/env bash
#
# wt — pick a git worktree with fzf, open it in Zed and/or run Claude Code there.
#
# The picker LOOPS: after Zed opens, or after you quit claude, you land back on
# the (refreshed) list. Esc / ctrl-c / ctrl-q leaves wt.
#
#   enter    open worktree in Zed
#   ctrl-o   run `claude` in the worktree (new session)
#   ctrl-r   run `claude --resume` in the worktree (official session picker)
#   ctrl-e   open in Zed *and* run claude
#   ctrl-y   print the path and exit  (e.g.  cd "$(wt -p)" )
#
# Deps: git, fzf, zed, claude. Optional: jq (live-session badges).
# Config: ~/.config/wt/config   (shell syntax, sourced)
#           WT_DEFAULT_REPO="/path/to/main/repo"   # used when cwd is not a git repo
# No secrets are ever stored.

set -uo pipefail
IFS=$'\n\t'

PROG=${0##*/}
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/wt"
CONFIG_FILE="$CONFIG_DIR/config"
CLAUDE_PROJECTS="$HOME/.claude/projects"

# ---------------------------------------------------------------- helpers ---
die()  { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
warn() { printf '%s: %s\n' "$PROG" "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<EOF
$PROG — git worktree switcher for Zed + Claude Code

usage: $PROG [options]

  -C, --repo <path>   use this repo instead of auto-detecting from \$PWD
  -p, --print         print the selected path and exit (no action)
  -l, --list          print the worktree table to stdout and exit (no fzf)
  -n, --no-sessions   skip Claude session lookup (faster)
  -1, --once          act on one selection then exit (no loop)
  -h, --help          this help

keys inside fzf:
  enter    open in Zed             (then back to the list)
  ctrl-o   claude                  (new session; back to the list when you quit)
  ctrl-r   claude --resume         (existing sessions of that worktree)
  ctrl-e   Zed + claude
  ctrl-y   print path and exit
  esc / ctrl-c / ctrl-q            quit wt
EOF
}

# --------------------------------------------------------------- cli args ---
REPO_ARG=""
PRINT_ONLY=0
LIST_ONLY=0
WANT_SESSIONS=1
LOOP=1
while [ $# -gt 0 ]; do
  case "$1" in
    -C|--repo)        REPO_ARG="${2:-}"; [ -n "$REPO_ARG" ] || die "--repo needs a path"; shift 2 ;;
    -p|--print)       PRINT_ONLY=1; LOOP=0; shift ;;
    -l|--list)        LIST_ONLY=1; shift ;;
    -n|--no-sessions) WANT_SESSIONS=0; shift ;;
    -1|--once)        LOOP=0; shift ;;
    -h|--help)        usage; exit 0 ;;
    *)                die "unknown option: $1 (try --help)" ;;
  esac
done

for c in git fzf; do have "$c" || die "missing dependency: $c"; done

# ---------------------------------------------------------------- config ----
mkdir -p "$CONFIG_DIR"
WT_DEFAULT_REPO=""
# shellcheck disable=SC1090
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

# ------------------------------------------------------- locate the repo ----
# Any worktree works: `git worktree list` always reports the whole set,
# with the main worktree as its first entry.
repo_dir=""
if [ -n "$REPO_ARG" ]; then
  [ -d "$REPO_ARG" ] || die "not a directory: $REPO_ARG"
  repo_dir="$REPO_ARG"
elif git rev-parse --git-dir >/dev/null 2>&1; then
  repo_dir="$PWD"
elif [ -n "$WT_DEFAULT_REPO" ] && [ -d "$WT_DEFAULT_REPO" ]; then
  repo_dir="$WT_DEFAULT_REPO"
else
  die "not inside a git repository. Use --repo <path>, or set WT_DEFAULT_REPO in $CONFIG_FILE"
fi
git -C "$repo_dir" rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository: $repo_dir"

# Absolute path of the main worktree (first porcelain entry), for display only.
main_root=$(git -C "$repo_dir" worktree list --porcelain | awk '/^worktree /{sub(/^worktree /,""); print; exit}')

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/wt.XXXXXX") || die "mktemp failed"
trap 'rm -rf "$tmpdir"' EXIT
sessions_file="$tmpdir/sessions"
rows="$tmpdir/rows"
menu="$tmpdir/menu"

# --------------------------------------------------- live Claude sessions ---
# Official, scriptable source of truth: `claude agents --json`.
# Produces lines:  <cwd>\t<badge text>
refresh_sessions() {
  : > "$sessions_file"
  [ "$WANT_SESSIONS" -eq 1 ] || return 0
  have claude && have jq || return 0
  claude agents --json --all 2>/dev/null \
    | jq -r '.[]? | [.cwd // "", .name // .sessionId[0:8] // "?"] | @tsv' 2>/dev/null \
    | awk -F'\t' '
        { n[$1]++; if (!($1 in f)) f[$1]=$2 }
        END { for (p in n) printf "%s\t%d live (%s%s)\n", p, n[p], f[p], (n[p]>1 ? ", +" n[p]-1 : "") }
      ' > "$sessions_file"
}

# Historical (resumable) sessions: Claude Code exposes no non-interactive
# listing, so we only *count* the transcript files it keeps per project dir.
# Read-only hint; `claude --resume` stays the thing that actually resumes.
history_count() {
  [ "$WANT_SESSIONS" -eq 1 ] || { printf 0; return; }
  [ -d "$CLAUDE_PROJECTS" ] || { printf 0; return; }
  local slug dir
  slug=$(printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g')
  dir="$CLAUDE_PROJECTS/$slug"
  [ -d "$dir" ] || { printf 0; return; }
  printf '%s' "$(find "$dir" -maxdepth 1 -name '*.jsonl' -type f 2>/dev/null | wc -l | tr -d ' ')"
}

session_badge() {  # $1 = worktree path
  local live hist
  live=$(awk -F'\t' -v p="$1" '$1==p {print $2; exit}' "$sessions_file")
  hist=$(history_count "$1")
  if [ -n "$live" ]; then
    printf '● %s' "$live"
  elif [ "${hist:-0}" -gt 0 ]; then
    printf '◌ %s resumable' "$hist"
  fi
}

# ------------------------------------------------------ collect worktrees ---
# Parse porcelain output into rows: <label>\t<badge>\t<path>
wt_path=""; wt_branch=""; wt_flags=""
flush_row() {
  [ -n "$wt_path" ] || return 0
  local label="$wt_branch"
  [ -n "$wt_flags" ] && label="$label $wt_flags"
  [ "$wt_path" = "$main_root" ] && label="$label [main wt]"
  printf '%s\t%s\t%s\n' "$label" "$(session_badge "$wt_path")" "$wt_path" >> "$rows"
  wt_path=""; wt_branch=""; wt_flags=""
}

build_menu() {
  : > "$rows"
  wt_path=""; wt_branch=""; wt_flags=""
  while IFS= read -r line; do
    case "$line" in
      worktree\ *) flush_row; wt_path="${line#worktree }" ;;
      branch\ *)   wt_branch="${line#branch refs/heads/}" ;;
      detached)    wt_branch="(detached)" ;;
      bare)        wt_branch="(bare)" ;;
      locked*)     wt_flags="$wt_flags 🔒" ;;
      prunable*)   wt_flags="$wt_flags ⚠" ;;
    esac
  done < <(git -C "$repo_dir" worktree list --porcelain)
  flush_row
  [ -s "$rows" ] || die "no worktrees found in $repo_dir"

  # Pad columns 1 and 2 so paths line up; keep the raw path as the last field.
  awk -F'\t' '
    { b[NR]=$1; s[NR]=$2; p[NR]=$3; if (length($1)>w) w=length($1); if (length($2)>v) v=length($2) }
    END { for (i=1;i<=NR;i++) printf "\033[1;36m%-*s\033[0m  \033[33m%-*s\033[0m  \033[2m%s\033[0m\t%s\n", w, b[i], v, s[i], p[i], p[i] }
  ' "$rows" > "$menu"
}

# ---------------------------------------------------------------- actions ---
open_zed() {  # $1 = worktree path
  have zed || { warn "zed CLI not found (Zed > Install CLI)"; return 1; }
  zed "$1" || warn "zed failed to open $1"
}

# Run claude in a subshell: wt keeps its own cwd and regains control on quit.
run_claude() {  # $1 = worktree path, rest = extra claude args
  local p="$1"; shift
  have claude || { warn "claude CLI not found"; return 1; }
  ( cd "$p" && claude "$@" )
}

# ------------------------------------------------------------- main loop ----
while :; do
  refresh_sessions
  build_menu

  if [ "$LIST_ONLY" -eq 1 ]; then
    awk -F'\t' '{print $1}' "$menu"
    exit 0
  fi

  sel=$(
    fzf --ansi \
        --delimiter=$'\t' --with-nth=1 \
        --height=80% --reverse --border \
        --prompt="worktree> " \
        --header=$'enter: Zed  |  ctrl-o: claude  |  ctrl-r: resume  |  ctrl-e: Zed+claude  |  ctrl-y: path  |  esc: quit' \
        --expect=ctrl-o,ctrl-r,ctrl-e,ctrl-y,ctrl-q \
        --preview='git -C {2} status --short --branch 2>/dev/null | head -15; echo; git -C {2} log --oneline --decorate -n 10 2>/dev/null' \
        --preview-window=right:50%:wrap \
        < "$menu"
  )
  # Empty selection = esc / ctrl-c / no match -> leave wt.
  [ -n "$sel" ] || break

  key=$(printf '%s\n' "$sel" | sed -n '1p')
  path=$(printf '%s\n' "$sel" | sed -n '2p' | awk -F'\t' '{print $2}')
  [ "$key" = "ctrl-q" ] && break
  [ -n "$path" ] || break
  if [ ! -d "$path" ]; then
    warn "worktree path no longer exists: $path"
    continue
  fi

  if [ "$PRINT_ONLY" -eq 1 ]; then
    printf '%s\n' "$path"
    break
  fi

  case "$key" in
    ctrl-y) printf '%s\n' "$path"; break ;;
    ctrl-o) run_claude "$path" ;;
    ctrl-r) run_claude "$path" --resume ;;
    ctrl-e) open_zed "$path"; run_claude "$path" ;;
    *)      open_zed "$path" ;;
  esac

  [ "$LOOP" -eq 1 ] || break
done
