// zrush tasks for Zed — copied to ~/.config/zed/tasks.json by ./install.sh
// Run with: cmd-shift-p > "task: spawn", or bind a key (see README).
[
  {
    "label": "zrush: worktrees (global)",
    "command": "zrush",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "center",
    "hide": "never"
  },
  {
    "label": "zrush: worktrees (this project)",
    "command": "zrush",
    "args": ["--repo", "$ZED_WORKTREE_ROOT"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "center",
    "hide": "never"
  }
]
