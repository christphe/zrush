// zrush tasks for Zed — installed into ~/.config/zed/tasks.json by ./install.sh
// Run with: cmd-shift-p > "task: spawn", or bind a key (see zed/keymap.json).
[
  {
    "label": "zrush: session here",
    "command": "zrush",
    "args": ["session"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "zrush: worktrees (global)",
    "command": "zrush",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "center",
    "hide": "never"
  },
  {
    "label": "zrush: worktrees (this project)",
    "command": "zrush",
    "args": ["--repo", "$ZED_WORKTREE_ROOT"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "center",
    "hide": "never"
  }
]
