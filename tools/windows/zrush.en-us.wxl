<WixLocalization Culture="en-US" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="VerifyReadyDlgInstallTitle" Value="{\WixUI_Font_Title}[ZrushReadyTitle]" />
  <String Id="VerifyReadyDlgInstallText" Value="[ZrushReadyText]" />
  <String Id="VerifyReadyDlgInstall" Value="[ZrushReadyButton]" />
  <String Id="ExitDialogDescription" Value="[ZrushDoneText]" />
</WixLocalization>
