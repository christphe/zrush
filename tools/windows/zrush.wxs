<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-only
  Copyright (C) 2026 Christophe Opoix

  The desktop app's Windows installer: the usual pages (welcome, the licence
  to accept, the folder to install to, a last look before anything is
  written), zrush.exe in that folder, a Start menu entry, and an entry in
  Apps to remove it. The last page offers to start the zrush just
  installed. Built by CI with WiX v5 and its UI and Util extensions:

    wix extension add -g WixToolset.UI.wixext/5.0.2
    wix extension add -g WixToolset.Util.wixext/5.0.2
    tools/windows/license-rtf.sh > target/License.rtf
    wix build tools/windows/zrush.wxs tools/windows/ui.wxs \
      -loc tools/windows/zrush.en-us.wxl -arch x64 \
      -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext \
      -d Version=0.2.0 -d Exe=path\to\zrush-gui.exe -d Cli=path\to\zrush.exe \
      -d License=target/License.rtf -o zrush.msi

  The UpgradeCode never changes: it is how a newer zrush.msi recognises an
  older install and replaces it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="zrush"
           Manufacturer="Christophe Opoix"
           Version="$(var.Version)"
           UpgradeCode="69BFAF66-3E99-4183-B6FA-BE1D6D32F549"
           Scope="perMachine"
           Language="1033">
    <!-- Same version too: a rebuild replaces the install rather than
         landing beside it as a second entry in Apps. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer zrush is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="zrush.ico" SourceFile="crates/zrush-gui/assets/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="zrush.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/christphe/zrush" />

    <!-- An update goes where the last install went, not back to the
         default: the folder picked then is read back here. -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Root="HKLM" Key="Software\zrush" Name="InstallFolder" Type="raw" />
    </Property>
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <!-- The pages' words: WiX's own, and on an update WiX's own update
         wording (tools/windows/ui.wxs for the first page, zrush.en-us.wxl
         for the others). The version an update replaces is read back
         where the last install wrote it (from 0.2.1 on). -->
    <Property Id="ZRUSHPREVIOUSVERSION">
      <RegistrySearch Root="HKLM" Key="Software\zrush" Name="Version" Type="raw" />
    </Property>
    <Property Id="ZrushReadyTitle" Value="Ready to install zrush" />
    <Property Id="ZrushReadyText"
              Value="Click Install to begin the installation. Click Back to review or change any of your installation settings. Click Cancel to exit the wizard." />
    <Property Id="ZrushReadyButton" Value="&amp;Install" />
    <Property Id="ZrushDoneText" Value="Click the Finish button to exit the Setup Wizard." />

    <SetProperty Id="ZrushVersions" Action="ZrushVersionsKnown" Sequence="ui" After="AppSearch"
                 Condition="WIX_UPGRADE_DETECTED AND ZRUSHPREVIOUSVERSION AND ZRUSHPREVIOUSVERSION &lt;&gt; ProductVersion"
                 Value="From version [ZRUSHPREVIOUSVERSION] to [ProductVersion]." />
    <SetProperty Id="ZrushVersions" Action="ZrushVersionsSame" Sequence="ui" After="AppSearch"
                 Condition="WIX_UPGRADE_DETECTED AND ZRUSHPREVIOUSVERSION = ProductVersion"
                 Value="Version [ProductVersion], installed again." />
    <SetProperty Id="ZrushVersions" Action="ZrushVersionsUnknown" Sequence="ui" After="AppSearch"
                 Condition="WIX_UPGRADE_DETECTED AND NOT ZRUSHPREVIOUSVERSION"
                 Value="To version [ProductVersion]." />
    <SetProperty Id="ZrushReadyTitle" Action="ZrushUpdateReadyTitle" Sequence="ui"
                 After="AppSearch" Condition="WIX_UPGRADE_DETECTED"
                 Value="Ready to update zrush" />
    <SetProperty Id="ZrushReadyText" Action="ZrushUpdateReadyText" Sequence="ui"
                 After="AppSearch" Condition="WIX_UPGRADE_DETECTED"
                 Value="Click Update to begin the update. Click Back to review or change any of your installation settings. Click Cancel to exit the wizard." />
    <SetProperty Id="ZrushReadyButton" Action="ZrushUpdateReadyButton" Sequence="ui"
                 After="AppSearch" Condition="WIX_UPGRADE_DETECTED"
                 Value="&amp;Update" />
    <SetProperty Id="ZrushDoneText" Action="ZrushUpdateDoneText" Sequence="ui"
                 After="AppSearch" Condition="WIX_UPGRADE_DETECTED"
                 Value="zrush has been updated to version [ProductVersion]. Click the Finish button to exit the Setup Wizard." />

    <UIRef Id="ZrushUI" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.License)" />
    <!-- zrush's own pictures instead of WiX's: the strip atop each page,
         and the panel beside the first and last ones. -->
    <WixVariable Id="WixUIBannerBmp" Value="tools/windows/banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="tools/windows/dialog.bmp" />

    <!-- A zrush still open is Windows Installer's own business: its page
         offers to close it and start it again after, which zrush answers
         (crates/zrush-session-end). -->

    <!-- The last page's box, ticked: start the zrush just installed. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch zrush" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#zrushExe]" />
    <CustomAction Id="LaunchZrush" BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixShellExec" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction"
               Value="LaunchZrush"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="zrush" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main">
      <Component Directory="INSTALLFOLDER">
        <File Id="zrushExe" Source="$(var.Exe)" Name="zrush.exe" KeyPath="yes">
          <Shortcut Id="startMenu"
                    Name="zrush"
                    Description="Your repositories, their worktrees and their agents' sessions"
                    Directory="ProgramMenuFolder"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="zrush.ico"
                    Advertise="yes" />
        </File>
      </Component>
      <!-- The command line, for the editor's key: Settings > Editor
           shortcut writes a task naming it by its path here. -->
      <Component Directory="INSTALLFOLDER">
        <File Id="zrushCli" Source="$(var.Cli)" Name="zrush-cli.exe" KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <RegistryValue Root="HKLM" Key="Software\zrush" Name="InstallFolder"
                       Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <!-- For the next update's first page to name the version it replaces. -->
        <RegistryValue Root="HKLM" Key="Software\zrush" Name="Version"
                       Type="string" Value="[ProductVersion]" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Source="LICENSE" Name="LICENSE.txt" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Source="crates/zrush-gui/assets/fonts/OFL-Inter.txt" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Source="crates/zrush-gui/assets/fonts/OFL-JetBrainsMono.txt" />
      </Component>
    </Feature>
  </Package>
</Wix>
